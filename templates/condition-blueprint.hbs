<div class="bna-blueprint-root">
<header class="bna-blueprint-heading">
  <div class="bna-blueprint-brand"><i class="fa-solid fa-diagram-project" aria-hidden="true"></i><div><span>Build-n-Action / {{localize "BUILD_N_ACTION.Blueprint.Title"}}</span><h2>{{name}}</h2></div></div>
  <div class="bna-blueprint-save"><span data-bp-status role="status"></span><button type="button" class="bna-primary" data-bp-action="save"><i class="fa-solid fa-check" aria-hidden="true"></i> {{localize "BUILD_N_ACTION.Blueprint.Save"}}</button></div>
</header>
<div class="bna-blueprint-toolbar" role="toolbar" aria-label="{{localize 'BUILD_N_ACTION.Blueprint.Layout'}}">
  <div><button type="button" data-bp-action="undo" title="{{localize 'BUILD_N_ACTION.Blueprint.Undo'}} (Ctrl+Z)"><i class="fa-solid fa-rotate-left" aria-hidden="true"></i><span>{{localize "BUILD_N_ACTION.Blueprint.Undo"}}</span></button><button type="button" data-bp-action="redo" title="{{localize 'BUILD_N_ACTION.Blueprint.Redo'}} (Ctrl+Shift+Z)"><i class="fa-solid fa-rotate-right" aria-hidden="true"></i><span>{{localize "BUILD_N_ACTION.Blueprint.Redo"}}</span></button></div>
  <div><button type="button" data-bp-action="fit"><i class="fa-solid fa-expand" aria-hidden="true"></i> {{localize "BUILD_N_ACTION.Blueprint.Fit"}}</button><button type="button" data-bp-action="zoomOut" aria-label="{{localize 'BUILD_N_ACTION.Blueprint.ZoomOut'}}">−</button><output data-bp-zoom>100%</output><button type="button" data-bp-action="zoomIn" aria-label="{{localize 'BUILD_N_ACTION.Blueprint.ZoomIn'}}">+</button></div>
  <button type="button" data-bp-action="validate"><i class="fa-solid fa-list-check" aria-hidden="true"></i> {{localize "BUILD_N_ACTION.Blueprint.Validate"}} <span data-bp-validity></span></button>
</div>
<div class="bna-blueprint-workspace">
  <aside class="bna-blueprint-catalog" aria-label="{{localize 'BUILD_N_ACTION.Blueprint.Catalog'}}">
    <h3>{{localize "BUILD_N_ACTION.Blueprint.Catalog"}}</h3>
    <label class="bna-blueprint-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input type="search" data-bp-search placeholder="{{localize 'BUILD_N_ACTION.Blueprint.Search'}}" aria-label="{{localize 'BUILD_N_ACTION.Blueprint.Search'}}"></label>
    <h4>{{localize "BUILD_N_ACTION.Blueprint.Logic"}}</h4><div class="bna-logic-tools">{{#each gates}}<button type="button" data-bp-action="add" data-type="{{type}}" title="{{hint}}">{{label}}</button>{{/each}}</div>
    <h4>{{localize "BUILD_N_ACTION.Blueprint.Conditions"}}</h4><div data-bp-catalog></div>
  </aside>
  <main class="bna-blueprint-canvas" data-bp-canvas tabindex="0" aria-label="{{localize 'BUILD_N_ACTION.Blueprint.Title'}}">
    <div class="bna-blueprint-world" data-bp-world><svg class="bna-blueprint-edges" data-bp-edges aria-hidden="true"></svg><div data-bp-nodes></div></div>
    <p class="bna-blueprint-canvas-hint" data-bp-connect-hint>{{localize "BUILD_N_ACTION.Blueprint.ConnectHint"}}</p>
  </main>
  <aside class="bna-blueprint-inspector" aria-label="{{localize 'BUILD_N_ACTION.Blueprint.Inspector'}}"><div data-bp-inspector></div></aside>
</div>
<footer class="bna-blueprint-footer">
  <details class="bna-blueprint-diagnostics" open><summary>{{localize "BUILD_N_ACTION.Blueprint.Diagnostics"}} <span data-bp-issue-count></span></summary><div data-bp-diagnostics role="status" aria-live="polite"></div></details>
  <details class="bna-blueprint-trial"><summary><i class="fa-solid fa-flask" aria-hidden="true"></i> {{localize "BUILD_N_ACTION.Blueprint.Trial"}}</summary>
    <p>{{localize "BUILD_N_ACTION.Blueprint.TrialHint"}}</p>
    <div class="bna-blueprint-trial-fields">
      <label>{{localize "BUILD_N_ACTION.Blueprint.Actor"}}<select data-bp-context="actor"></select></label>
      <label>{{localize "BUILD_N_ACTION.Blueprint.Item"}}<select data-bp-context="item"></select></label>
      <label>{{localize "BUILD_N_ACTION.Blueprint.Activity"}}<select data-bp-context="activity"></select></label>
      <label>{{localize "BUILD_N_ACTION.Blueprint.Target"}}<select data-bp-context="target"></select></label>
      <button type="button" data-bp-action="trial">{{localize "BUILD_N_ACTION.Blueprint.Run"}}</button>
    </div><p class="hint">{{localize "BUILD_N_ACTION.Blueprint.TrialLimit"}}</p><div data-bp-trial-result role="status" aria-live="polite"></div>
  </details>
</footer>
</div>
