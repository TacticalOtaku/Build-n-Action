<div class="tab scrollable {{tabs.description.cssClass}}" data-tab="description" data-group="main">
  <fieldset>
    <legend>{{fields.description.field.label}}</legend>
    <div class="form-group">
      <label>{{fields.img.field.label}}</label>
      <div class="form-fields">
        <input type="text" name="img" value="{{fields.img.value}}">
        <button type="button" data-action="editImage" data-tooltip="{{fields.img.field.label}}" aria-label="{{fields.img.field.label}}">
          <i class="fa-solid fa-folder-open" inert></i>
        </button>
      </div>
      <p class="hint">{{fields.img.field.hint}}</p>
    </div>

    {{#with fields.description}}
    {{formGroup field value=value enriched=enriched height=height button=true toggled=true}}
    {{/with}}
  </fieldset>
</div>
