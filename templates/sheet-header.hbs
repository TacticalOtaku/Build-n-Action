<div class="header name-stacked">
  <img src="{{bonus.img}}" alt="{{bonus.name}}" data-bna-image-preview data-fallback-src="icons/svg/dice-target.svg">
  <input class="title" type="text" name="name" value="{{bonus.name}}" placeholder="{{localize 'Name'}}">
  <ul class="properties">
    {{#each labels}}
    <li class="property">{{this}}</li>
    {{/each}}
  </ul>
</div>
