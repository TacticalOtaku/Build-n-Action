<div class="header name-stacked">
  <img src="{{bonus.img}}" alt="{{bonus.name}}" data-bna-image-preview data-fallback-src="icons/svg/dice-target.svg">
  <input class="title" type="text" name="name" value="{{bonus.name}}" placeholder="{{localize 'Name'}}">
  <ul class="properties">
    {{#each labels}}
    <li class="property">{{this}}</li>
    {{/each}}
  </ul>
  <button type="button" class="bna-blueprint-launch" data-action="openBlueprint"><i class="fa-solid fa-diagram-project" aria-hidden="true"></i> {{localize "BUILD_N_ACTION.Blueprint.Open"}}</button>
  {{#if hasGraph}}<p class="bna-blueprint-banner">{{localize "BUILD_N_ACTION.Blueprint.ActiveGraph"}}</p>{{/if}}
</div>
